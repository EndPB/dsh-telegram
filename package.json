{
  "name": "@local/dsh-telegram",
  "version": "0.3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EndPB/dsh-telegram.git"
  },
  "homepage": "https://github.com/EndPB/dsh-telegram#readme",
  "description": "Telegram user-account (MTProto) access for DeepSeek Harness: channels, messages, in-channel search, comments, links, whitelisted sending, plus a DSH bot chat and a Telegram → DSH bridge, all managed from a mobile-friendly Settings page",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/*.png",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dependencies": {
    "telegram": "2.26.22"
  }
}
